# ── الخادم المحلي ───────────────────────────────────────────
# 127.0.0.1 = هذا الجهاز فقط. استخدم 0.0.0.0 للوصول من جوال على نفس الشبكة.
HOST=127.0.0.1
PORT=4100

# ── Supabase ───────────────────────────────────────────────
# نفس مشروع متجر ستور. مفتاح service_role يبقى على الخادم فقط.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── الجلسة ─────────────────────────────────────────────────
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# ── المتجر (اختياري) ───────────────────────────────────────
# رابط متجر Next المحلي — يُستخدم لزر «المتجر» ولتحديث الكاش.
STORE_URL=http://localhost:3000
STORE_REVALIDATE_URL=http://localhost:3000/api/revalidate
STORE_REVALIDATE_SECRET=
