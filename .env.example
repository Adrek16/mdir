# ══════════════════════════════════════════════════════════
# لوحة مدير ستور — تطبيق ويب مستضاف (Netlify Functions) + Supabase
# انسخ هذا الملف إلى .env محلياً؛ وعلى Netlify أضف نفس المتغيرات من:
# Site configuration → Environment variables  (لا ترفع .env للمستودع)
# ══════════════════════════════════════════════════════════

# ── الخادم المستقل فقط (لا يُستخدم على Netlify) ────────────
# محلياً 127.0.0.1 = هذا الجهاز فقط. على منصة تستضيف Node اترك HOST فارغاً
# أو استخدم 0.0.0.0 ودع المنصة تحقن PORT.
HOST=127.0.0.1
PORT=4100

# ── Supabase (قاعدة البيانات والمصادقة والتخزين) ───────────
# نفس مشروع متجر ستور. مفتاح service_role يبقى على الخادم فقط.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── الجلسة ─────────────────────────────────────────────────
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# ── الموقع العام ───────────────────────────────────────────
# الرابط النهائي للوحة (يُستخدم للتحقق من Origin). اتركه فارغاً
# ليُستنتج من رأس الطلب خلف الـ CDN.
# PUBLIC_SITE_URL=https://your-dashboard.netlify.app

# حماية إضافية اختيارية: عناوين IP مسموح بها فقط، مفصولة بفواصل.
# ADMIN_IP_ALLOWLIST=1.2.3.4,5.6.7.8

# ── واجهة المتجر للعملاء (اختياري) ─────────────────────────
# إن تُرك فارغاً يُخفى زر «المتجر». لا تستخدم localhost على موقع منشور.
# STORE_URL=https://store.example.com
# STORE_REVALIDATE_URL=https://store.example.com/api/revalidate
# STORE_REVALIDATE_SECRET=

# ── سكربتات القبول فقط (لا تُستخدم في تشغيل الموقع) ────────
# لا تضع بيانات دخول حقيقية في المستودع؛ هذه القيم في .env فقط.
# MANAGER_URL=http://127.0.0.1:4100
# (STORE_URL أعلاه يُستخدم أيضاً في الاختبارات؛ محلياً http://127.0.0.1:3000)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
